// Synoptic Source Latent Dirichlet Allocation (LDA)
// This model uses the log_sum_exp trick to marginalize out the discrete latent states.
// In this context, "topics" represent Latent Sources (K=4: Mark, Q, M, L).
// "Documents" represent individual pericopes (M).

data {
  int<lower=2> K;                    // number of latent sources (e.g., 4)
  int<lower=2> V;                    // size of Greek vocabulary
  int<lower=1> M;                    // number of pericopes (documents)
  int<lower=1> N;                    // total number of words across all pericopes
  
  array[N] int<lower=1,upper=V> w;   // word index for token n
  array[N] int<lower=1,upper=M> doc; // pericope index for token n
  
  vector<lower=0>[K] alpha;          // Dirichlet prior for pericope-source mixture
  vector<lower=0>[V] beta;           // Dirichlet prior for source-word distribution
}
parameters {
  array[M] simplex[K] theta;         // probability of each Source in each Pericope
  array[K] simplex[V] phi;           // probability of each Greek word in each Source
}
model {
  // Priors
  for (m in 1:M) {
    theta[m] ~ dirichlet(alpha);
  }
  for (k in 1:K) {
    phi[k] ~ dirichlet(beta);
  }

  // Likelihood (Marginalization over discrete latent source states)
  // For every word token in the database, we calculate the log probability 
  // that it was generated by Source K, and marginalize across all K sources.
  for (n in 1:N) {
    vector[K] gamma;
    for (k in 1:K) {
      // log P(Source k | Pericope m) + log P(Word w | Source k)
      gamma[k] = log(theta[doc[n], k]) + log(phi[k, w[n]]);
    }
    target += log_sum_exp(gamma); 
  }
}
